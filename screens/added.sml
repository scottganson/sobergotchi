<!-- Pop-up after two devices swap cards. -->
<screen id="added">
  <text h="36" font="script-s" align="center" margin="4 0 0 0">Friend added!</text>
  <image h="118" src="addfriend"/>
  <text h="32" font="name" align="center">{friend.name}</text>
  <text h="15" font="label-b" align="center">{friend.years} years sober</text>
  <text h="13" font="small" align="center">since {friend.date:MMM d, yyyy}</text>
  <text h="*" font="small" align="center">{friend.phone}</text>
</screen>
