<!-- Landing page, shown before Pip's setup (fresh flash or factory reset). Any key starts setup; setup left
     unfinished for 10 minutes comes back here. Picture: tools/make_landing.py -->
<screen id="landing">
  <col h="*" margin="1" border="1" radius="6">
    <spacer h="*"/>
    <image h="40" src="title"/>
    <text h="16" font="body" align="center">one day at a time</text>
    <spacer h="*"/>
    <image h="130" src="landing" valign="bottom"/>
    <spacer h="*"/>
    <text h="22" margin="0 3 6 3" font="small-b" align="center" fill="ink" radius="5">Press any key to start</text>
  </col>
</screen>
