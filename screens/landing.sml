<!-- Landing page, shown before Pip's setup (fresh flash or factory reset). Any key starts setup; setup left
     unfinished for 10 minutes comes back here. Picture: tools/make_landing.py -->
<screen id="landing">
  <col h="*" margin="1" border="1" radius="6">
    <spacer h="*"/>
    <image h="36" src="title"/>
    <text h="15" font="body" align="center">one day at a time</text>
    <spacer h="*"/>
    <image h="130" src="landing" valign="bottom"/>
    <spacer h="*"/>
    <col h="35" margin="0 3 5 3" fill="ink" radius="5" pad="3 0 3 0">
      <text h="12" font="small-b" align="center">Press any key to start</text>
      <text h="12" font="small-b" align="center">your sober adventure</text>
    </col>
  </col>
</screen>
