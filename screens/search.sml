<!-- Friends > Add friend: the radio is on, looking for another Sobergotchi. Any button stops. Also "No one found". -->
<screen id="search">
  <row h="21" fill="ink" pad="0 4 0 5">
    <text w="*" font="label-b">Add friend</text>
  </row>
  <image h="122" src="addfriend"/>
  <text h="18" font="label-b" align="center">{search.title}</text>
  <wrap h="*" font="label" lh="13" margin="2 6 0 6" align="center">{search.text}</wrap>
  <text h="13" font="small" align="center">{hint}</text>
  <spacer h="4"/>
</screen>
