<!-- Add friend (enter + up held): the radio is on while held, looking for another Sobergotchi. Also "No one found". -->
<screen id="search">
  <row h="21" fill="ink" pad="0 4 0 5">
    <text w="*" font="head">Communicating</text>
  </row>
  <image h="122" src="signal"/>
  <text h="18" font="head" align="center">{search.title}</text>
  <wrap h="*" font="label" lh="13" margin="2 6 0 6" align="center">{search.text}</wrap>
  <text h="13" font="small" align="center">{hint}</text>
  <spacer h="4"/>
</screen>
