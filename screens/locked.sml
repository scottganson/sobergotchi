<!-- Enter on a locked row of Your path: when it opens. Enter closes. -->
<screen id="locked">
  <row h="21" fill="ink" pad="0 4 0 5">
    <text w="*" font="head">{lock.name}</text>
  </row>
  <image h="110" src="gnomebig" index="4" valign="bottom"/>
  <image h="22" src="lock"/>
  <wrap h="*" font="label" lh="14" margin="4 6 0 6" align="center">{lock.text}</wrap>
  <row h="22" margin="0 4 4 4" pad="0 30">
    <text w="*" font="small-b" align="center" fill="ink" radius="5">&lt; Back</text>
  </row>
</screen>
