<!-- Awards (carousel page 6): the year coins, earned by years sober. Enter on the page picks a coin; up / down move,
     enter turns an earned coin over (or engraves it, once), a coin to come says when. -->
<screen id="awards">
  <row h="21" fill="ink" pad="0 4 0 5">
    <text w="*" font="head">Awards</text>
    <text w="50" font="small-b" align="right">{aw.count}</text>
  </row>
  <row h="46"><stack w="*"><col if="aw.s0" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e0" src="coin"/><image if="!aw.e0" src="coinlock"/><text if="aw.e0" font="head" align="center">1</text></stack><text h="10" font="small" align="center">1 yr</text></col></stack><stack w="*"><col if="aw.s1" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e1" src="coin"/><image if="!aw.e1" src="coinlock"/><text if="aw.e1" font="head" align="center">2</text></stack><text h="10" font="small" align="center">2 yrs</text></col></stack><stack w="*"><col if="aw.s2" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e2" src="coin"/><image if="!aw.e2" src="coinlock"/><text if="aw.e2" font="head" align="center">3</text></stack><text h="10" font="small" align="center">3 yrs</text></col></stack></row>
  <row h="46"><stack w="*"><col if="aw.s3" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e3" src="coin"/><image if="!aw.e3" src="coinlock"/><text if="aw.e3" font="head" align="center">5</text></stack><text h="10" font="small" align="center">5 yrs</text></col></stack><stack w="*"><col if="aw.s4" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e4" src="coin"/><image if="!aw.e4" src="coinlock"/><text if="aw.e4" font="head" align="center">10</text></stack><text h="10" font="small" align="center">10 yrs</text></col></stack><stack w="*"><col if="aw.s5" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e5" src="coin"/><image if="!aw.e5" src="coinlock"/><text if="aw.e5" font="head" align="center">15</text></stack><text h="10" font="small" align="center">15 yrs</text></col></stack></row>
  <row h="46"><stack w="*"><col if="aw.s6" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e6" src="coin"/><image if="!aw.e6" src="coinlock"/><text if="aw.e6" font="head" align="center">20</text></stack><text h="10" font="small" align="center">20 yrs</text></col></stack><stack w="*"><col if="aw.s7" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e7" src="coin"/><image if="!aw.e7" src="coinlock"/><text if="aw.e7" font="head" align="center">30</text></stack><text h="10" font="small" align="center">30 yrs</text></col></stack><stack w="*"><col if="aw.s8" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e8" src="coin"/><image if="!aw.e8" src="coinlock"/><text if="aw.e8" font="head" align="center">40</text></stack><text h="10" font="small" align="center">40 yrs</text></col></stack></row>
  <row h="46"><spacer w="*"/><stack w="*"><col if="aw.s9" border="2" radius="6" margin="0 3"/><col w="*"><stack h="36"><image if="aw.e9" src="coin"/><image if="!aw.e9" src="coinlock"/><text if="aw.e9" font="head" align="center">50</text></stack><text h="10" font="small" align="center">50 yrs</text></col></stack><spacer w="*"/></row>
  <stack h="24" margin="2 30 0 30"><text if="aw.back" font="small-b" align="center" fill="ink" radius="5">&lt; Back</text><text if="aw.ret" font="small-b" align="center" border="1" radius="5">&lt; Back</text></stack>
  <text h="12" font="small" align="center">{hint}</text>
  <dots h="9" count="8"/>
</screen>
